      "hero": {
        "title": "All-in-One Growth Platform for bars",
        "description": "We help bar owners attract new guests, turn them into loyal regulars, and grow their business with loyalty programs, promotions and easy discovery. All in one easy-to-use platform built for growth. Essential loyalty tools are available today and will remain completely free forever."
      },
      "contactUs": {
        "title": "Contact Us",
        "description": "Interested in increasing guest loyalty and visibility for your bar? We'd love to hear from you. Whether you want to register your venue, start using our free loyalty tools, or learn about upcoming features: our team is ready to help. Reach out to us at <email>contacts@kegry.com</email> or through our <chat>chat</chat>."
      },
      "features": {
        "one": {
          "title": "Boost Your Visibility",
          "text": "After creating your account, you'll immediately gain access to manage you venue, discounts and promotions. Once your venue is verified, it will become visible to users on our social platform."
        },
        "two": {
          "title": "Build Customer Loyalty",
          "text": "Create up to 4 loyalty levels based on how many times your guests visit. Set a different discount for each level, and vary the discount depending on the day of the week. Simple to set up, fully automatic, and perfect for bringing customers back."
        },
        "three": {
          "title": "Easy QR Check-In",
          "text": "Place QR codes on the tables for guests to scan themselves, or have your team open the QR code on their phone via the business portal and let the guest scan it. Either way, every visit is counted automatically and your regulars move up the loyalty levels with zero extra effort."
        }
      }
    },
