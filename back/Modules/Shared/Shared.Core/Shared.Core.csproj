<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>SharedCore</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Humanizer" Version="3.0.1" />
      <PackageReference Include="Serilog" Version="4.3.0" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    </ItemGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Localization\DateTimeHumanizer.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>DateTimeHumanizer.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

</Project>
