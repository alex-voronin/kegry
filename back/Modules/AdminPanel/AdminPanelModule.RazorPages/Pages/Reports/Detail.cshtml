@page "{id:guid}"
@model AdminPanelModule.RazorPages.Pages.Reports.DetailModel
@{
    ViewData["Title"] = "User Reports Detail";
}

<div style="display:flex; gap:8px; margin-bottom:16px;">
    <a asp-page="/Reports/Index" class="btn btn-outline">← Back to List</a>
</div>

<div class="card">
    <div class="card-header">
        Reports for @Model.TargetUser
    </div>
    
    @if (!Model.Reports.Any())
    {
        <div class="card-body text-muted">No specific reports found for this user.</div>
    }
    else
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Reported By</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reports)
                    {
                        <tr>
                            <td class="text-muted text-sm" style="width:160px;">@r.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td style="width:200px;">
                                <div style="font-weight:500">@r.ReporterName</div>
                                <div class="text-muted text-sm">ID: @r.ReporterId.ToString()</div>
                            </td>
                            <td>
                                <div style="background:var(--bg); padding:10px 12px; border-radius:6px; font-size:13px; line-height:1.5;">
                                    @r.Message
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
