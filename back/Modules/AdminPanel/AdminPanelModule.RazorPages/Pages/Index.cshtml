@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Pending Verification</div>
        <div class="stat-value">@Model.PendingVenues</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total B2B Users</div>
        <div class="stat-value">@Model.TotalB2BUsers</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Open Reports</div>
        <div class="stat-value">@Model.OpenReports</div>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <div class="card">
        <div class="card-header">Venues Awaiting Verification</div>
        <div class="card-body">
            <p class="text-muted" style="margin-bottom:16px;">@Model.PendingVenues venue(s) need to be reviewed and verified before they appear in the app.</p>
            <a asp-page="/Venues/Index" class="btn btn-primary">Go to Venue Verification →</a>
        </div>
    </div>
    <div class="card">
        <div class="card-header">B2B Users & Reports</div>
        <div class="card-body">
            <p class="text-muted" style="margin-bottom:16px;">Manage B2B business accounts and review user-submitted reports.</p>
            <a asp-page="/B2BUsers/Index" class="btn btn-primary">Go to B2B Users →</a>
        </div>
    </div>
</div>
