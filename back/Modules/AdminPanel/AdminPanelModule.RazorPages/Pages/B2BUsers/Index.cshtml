@page
@model AdminPanelModule.RazorPages.Pages.B2BUsers.IndexModel
@{
    ViewData["Title"] = "B2B Users & Reports";
}

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div style="display:grid; grid-template-columns:1fr 320px; gap:16px;">
    <div class="card">
        <div class="card-header">
            B2B User Accounts
            <span class="text-muted text-sm">@Model.TotalCount total</span>
        </div>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Email / Username</th>
                        <th>Created</th>
                        <th>Confirmed</th>
                        <th>Locked</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td>
                                <div style="font-weight:500">@u.Email</div>
                                <div class="text-muted text-sm">@u.UserName</div>
                            </td>
                            <td class="text-muted text-sm">@u.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>@(u.EmailConfirmed ? "Yes" : "No")</td>
                            <td>@(u.IsLocked ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-body" style="padding-top:12px; padding-bottom:12px;">
            <div class="pagination">
                @if (Model.PageNumber > 1)
                {
                    <a asp-page="/B2BUsers/Index" asp-route-page="@(Model.PageNumber - 1)" class="page-link">← Prev</a>
                }
                <span class="page-link active">@Model.PageNumber</span>
                @if (Model.HasNextPage)
                {
                    <a asp-page="/B2BUsers/Index" asp-route-page="@(Model.PageNumber + 1)" class="page-link">Next →</a>
                }
            </div>
        </div>
    </div>

    <div class="card" style="align-self:start;">
        <div class="card-header">Create B2B Account</div>
        <div class="card-body">
            <p class="text-muted" style="margin-bottom:16px; font-size:12px;">
                Create a pre-verified B2B user account. The user can immediately log in with these credentials.
            </p>
            <form method="post" asp-page-handler="Create">
                <div class="form-group">
                    <label>Email</label>
                    <input class="form-control" type="email" name="Email" required autocomplete="new-email" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input class="form-control" type="text" name="Password" required autocomplete="new-password" />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">Create Account</button>
            </form>
        </div>
    </div>
</div>
