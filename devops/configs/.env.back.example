# ==================== ASP.NET Core ====================
ASPNETCORE_ENVIRONMENT=Production

# ==================== Serilog ====================
Serilog__Using__0=Serilog.Sinks.Console

Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__MinimumLevel__Override__System=Warning
Serilog__MinimumLevel__Override__Wolverine=Information
Serilog__MinimumLevel__Override__Wolverine.Runtime=Information
Serilog__MinimumLevel__Override__Wolverine.Handlers=Information
Serilog__MinimumLevel__Override__Wolverine.Persistence=Information

Serilog__WriteTo__0__Name=Console
Serilog__WriteTo__0__Args__outputTemplate="[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"

Serilog__Enrich__0=FromLogContext
Serilog__Enrich__1=WithMachineName
Serilog__Enrich__2=WithThreadId
Serilog__Enrich__3=WithEnvironmentName

# ==================== Kestrel ====================
Kestrel__Endpoints__Http__Url="http://0.0.0.0:5214:

# ==================== Connection Strings ====================
ConnectionStrings__kegrydb="User ID=postgres;Password=postgres;Host=localhost;Port=5432;Database=kegrydb;Pooling=true;Application Name=kegry-back"

# ==================== Storage (S3 / MinIO) ====================
Storage__S3Config__AccessKey=your_access_key
Storage__S3Config__SecretKey=your_secret_key
Storage__S3Config__ServiceUrl=https://s3.your-region.amazonaws.com
Storage__S3Config__BucketName=your-bucket
Storage__S3Config__PublicUrl=https://your-bucket.s3.your-region.amazonaws.com
Storage__S3Config__KeySalt=some-random-salt-for-filenames

# ==================== Authentication ====================
Authentication__AuthTokenConfig__Secret=super-long-random-jwt-secret-at-least-32-chars
Authentication__AuthTokenConfig__Issuer=https://your-api.com
Authentication__AuthTokenConfig__Audience=customers
Authentication__AuthTokenConfig__AccessTokenDurationInDays=1
Authentication__AuthTokenConfig__RefreshTokenDurationInDays=30
Authentication__AuthTokenConfig__MaxSimultaneousLoggedInDevices=10

Authentication__GoogleAuthConfig__ClientId=your-google-client-id

# ==================== Notifications ====================
Notifications__FirebaseConfig=your-firebase-service-account-json-as-base64-or-string
Notifications__EmailConfig__AppId=your-email-app-id
Notifications__EmailConfig__FromEmail=no-reply@yourdomain.com
Notifications__EmailConfig__ApiKey=your-email-provider-api-key

# ==================== Monitoring & Analytics ====================
Monitoring__MetricsServerConfig__Hostname=0.0.0.0
Monitoring__MetricsServerConfig__Port=9500

PostHog__ProjectApiKey=phc_xxxxxxxxxxxxxxxxxxxxxxxx
PostHog__HostUrl=https://eu.i.posthog.com
PostHog__Debug=false

# ==================== Admin Panel ====================
AdminPanel__Username=admin
AdminPanel__PasswordHash=$2a$12$...hashed-password...

# ==================== Runtime / GC ====================
# RuntimeOptions__ConfigProperties__System.GC.Server=true