# ==================== vmagent → Grafana Cloud ====================
# Remote write endpoint (Prometheus-compatible)
VM_REMOTE_WRITE_URL=https://prometheus-prod-xx-xxx.grafana.net/api/prom/push

# Grafana Cloud Instance ID (numeric)
VM_REMOTE_WRITE_USERNAME=123456

# Grafana Cloud API Token (with MetricsPublisher / metrics:write scope)
VM_REMOTE_WRITE_PASSWORD=glc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
