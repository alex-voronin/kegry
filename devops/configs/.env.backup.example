# ==================== Kartoza S3 Backup (Cloudflare R2) ====================
# See: https://github.com/kartoza/docker-pg-backup/blob/master/docker-env.md

ACCESS_KEY_ID=your_r2_access_key_id
SECRET_ACCESS_KEY=your_r2_secret_access_key
# Note: without https:// prefix — s3cmd adds it based on SSL_SECURE
HOST_BASE=<account_id>.r2.cloudflarestorage.com
HOST_BUCKET=<account_id>.r2.cloudflarestorage.com

BUCKET=kegry-db-backups
DEFAULT_REGION=auto
SSL_SECURE=True
